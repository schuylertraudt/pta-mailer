# Copy to .env.local (never commit real values).

# Postgres (Neon/Supabase/local). Use the pooled URL for the app, direct URL for migrations if your host distinguishes them.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pta_mailer

# Creates the first admin officer. Ignored once any active admin exists.
BOOTSTRAP_ADMIN_EMAIL=

# Public base URL of this app (used in confirm/unsubscribe links).
APP_URL=http://localhost:3000

# --- Later phases ---
# Auth (Phase 3)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email delivery (Phase 2/6). From must be a role address on the PTA domain.
EMAIL_PROVIDER=ses
EMAIL_FROM="Example PTA <news@pta.example.org>"
EMAIL_REPLY_TO=
UNSUBSCRIBE_MAILTO=unsubscribe@pta.example.org
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=

# Object storage (Phase 5), S3-compatible.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Test database (tests create and wipe schema here).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pta_mailer_test
