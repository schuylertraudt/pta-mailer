# Copy to .env.local for development. In production set these in the host's
# environment settings (Vercel project settings / systemd EnvironmentFile).
# Never commit real values.

# --- Core ---
# Postgres (Neon/Supabase/local). Use the pooled URL if your host offers one.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pta_mailer
# Public base URL of this app, no trailing slash. Used in confirm/unsubscribe/archive links.
APP_URL=http://localhost:3000
# Random 32+ byte secret: `openssl rand -base64 32`. Signs auth cookies and subscribe-form tokens.
AUTH_SECRET=

# --- Officer sign-in (Google OAuth, scopes openid/email/profile only) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Creates the first admin on first sign-in. Ignored once any active admin exists.
BOOTSTRAP_ADMIN_EMAIL=

# --- Email delivery ---
# ses | console (logs only) | memory (tests)
EMAIL_PROVIDER=console
# Role address on the PTA domain (never a personal mailbox).
EMAIL_FROM="Example PTA <news@pta.example.org>"
EMAIL_REPLY_TO=
# Inbound address for List-Unsubscribe mailto (SES receiving rule -> SNS -> webhook).
UNSUBSCRIBE_MAILTO=unsubscribe@pta.example.org
# SES credentials (named SES_* because Vercel reserves AWS_* variable names).
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# SES configuration set that publishes bounce/complaint events to SNS.
SES_CONFIGURATION_SET=
# Stay at or below your SES max send rate.
SEND_RATE_PER_SECOND=10
# Comma-separated SNS topic ARNs the webhook accepts.
SNS_TOPIC_ARNS=
# Bearer secret for /api/cron/send-queue (Vercel Cron sends it automatically when set as CRON_SECRET).
CRON_SECRET=

# --- Image storage (S3-compatible: Cloudflare R2, S3, Supabase Storage) ---
# s3 | memory (local dev only; images served from /dev-storage and lost on restart)
STORAGE_DRIVER=memory
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
# Optional private bucket for unprocessed originals (they contain EXIF/GPS until processed).
S3_INCOMING_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public HTTPS base for stored images, e.g. https://images.pta.example.org (must be https in production).
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/dev-storage

# --- Optional bot protection on the subscribe form (Cloudflare Turnstile) ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Tests (the suite drops and rebuilds this database's schema) ---
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pta_mailer_test
